# Bare host root + gateway service prefix — NOT the /docs/remittance Swagger UI
# page, which sits behind its own separate nginx Basic-auth gate ("Remittance
# Service Docs" realm) unrelated to the API.
REMIT_API_BASE_URL=http://93.127.185.212/api/remittance
# Swagger-docs-only Basic-auth creds (unused by the app itself), kept only for
# browsing http://93.127.185.212/docs/remittance/swagger-ui/index.html.
REMIT_API_USER=
REMIT_API_PASS=

# Service-account login for the remittance API — it only validates Bearer
# JWTs issued by the auth service, so the server logs in with these once and
# reuses the token for every remittance API call. Server-side only.
REMIT_AUTH_USER=
REMIT_AUTH_PASS=

# Bare host root — NOT the /docs/auth Swagger UI page, which sits behind its
# own separate nginx Basic-auth gate ("Auth Service Docs" realm) unrelated to the API.
AUTH_API_BASE_URL=http://93.127.185.212
